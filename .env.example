CINEMATCH_DATABASE_URL=postgresql+psycopg://cinematch:cinematch@localhost:5432/cinematch
# Neon CLI (`neon deploy`) writes pooled/direct URLs; the app maps them when CINEMATCH_DATABASE_URL is unset or SQLite.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
POSTGRES_PORT=5432
CINEMATCH_DATA_DIR=./data
CINEMATCH_ARTIFACT_DIR=./artifacts
CINEMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CINEMATCH_READ_ONLY=false
CINEMATCH_LOG_LEVEL=INFO
CINEMATCH_TMDB_TOKEN=
CINEMATCH_PUBLIC_APP_URL=http://localhost:5173
CINEMATCH_AUTO_CREATE_SCHEMA=false
CINEMATCH_JWT_SECRET=replace-with-at-least-32-random-bytes
CINEMATCH_ACCESS_TOKEN_MINUTES=15
CINEMATCH_REFRESH_TOKEN_DAYS=30
CINEMATCH_SECURE_COOKIES=false
CINEMATCH_BANDIT_ENABLED=false
CINEMATCH_BANDIT_SHADOW=true
CINEMATCH_BANDIT_EPSILON=0.1
CINEMATCH_REDIS_URL=
# Leave SMTP blank in local development. Settings will show the verification code
# instead of emailing it. Set these to deliver username, email, and password codes.
CINEMATCH_SMTP_HOST=
CINEMATCH_SMTP_PORT=587
CINEMATCH_SMTP_USERNAME=
CINEMATCH_SMTP_PASSWORD=
CINEMATCH_SMTP_FROM=
CINEMATCH_SMTP_TLS=true
VITE_API_URL=http://localhost:8000/api
VITE_DEMO_FALLBACK=false
